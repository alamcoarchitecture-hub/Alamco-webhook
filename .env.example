# ---- Server ----
PORT=3000
# Set to 1 to print messages instead of sending (also automatic if WhatsApp creds are missing)
DRY_RUN=1
# Optional: protects POST /alamco-webhook. Send as header X-Webhook-Secret (or ?secret=... in the URL)
WEBHOOK_SECRET=
# Public base URL of the platform (used for track links)
SITE_URL=https://alamcostudio.com
# Added in front of 10-digit phone numbers
DEFAULT_COUNTRY_CODE=91

# ---- WhatsApp Cloud API (Meta) ----
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Owner number, digits only with country code
OWNER_WHATSAPP=917012332006
# Any string you choose; paste the same in Meta's webhook setup
WHATSAPP_VERIFY_TOKEN=change-me
# Optional: Meta App Secret, to verify X-Hub-Signature-256 on POST /whatsapp
WHATSAPP_APP_SECRET=
GRAPH_API_VERSION=v21.0

# ---- Optional approved templates (fallback when the 24h window is closed) ----
# new brief template body params: {{1}} client name, {{2}} phone, {{3}} brief id, {{4}} track link
WHATSAPP_TEMPLATE_NEW_BRIEF=
# instruction template body params: {{1}} client name, {{2}} phone, {{3}} brief id, {{4}} instruction, {{5}} track link
WHATSAPP_TEMPLATE_INSTRUCTION=
WHATSAPP_TEMPLATE_LANG=en
